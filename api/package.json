{
  "name": "mbp-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "npm run seed:mongo && npm run seed:postgres",
    "seed:mongo": "tsx src/seed/mongo.ts",
    "seed:postgres": "tsx src/seed/postgres.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --reporter=verbose",
    "test:load": "tsx tests/load/burst.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
