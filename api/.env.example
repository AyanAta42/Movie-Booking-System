# Postgres — transactional source of truth
# connection_limit raised from the default (cpus*2+1, ~17 here) because the
# write path is transaction-heavy and a burst of concurrent claims queues on
# connection checkout. Postgres max_connections defaults to 100, so this
# leaves ample headroom for a second process and psql.
DATABASE_URL="postgresql://mbp:mbp@localhost:5432/mbp?schema=public&connection_limit=40"

# MongoDB — read-only catalog content
MONGO_URL="mongodb://localhost:27017/mbp_catalog"

PORT=4000
